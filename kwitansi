<body class="bg-gradient-to-br from-orange-50 to-yellow-50 min-h-screen">
    <div class="container mx-auto px-4 py-8 max-w-4xl">
        <!-- Header -->
        <div class="bg-white rounded-2xl shadow-xl p-8 mb-8">
            <div class="flex items-center justify-center mb-6">
                <img src="https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEiPWTOigXHC4s2Jq1aJTWEPS-nTLyKot0alhBN4VtQCl-tmV7F29iXZuDoPXxX-mxVXBrzTa36G5xXzg4ZarWWegUAuN7QkfEBnEeJjl-IrE93CPvs5dAljCocRHbYhBZP4lcHSzyPEdRM6J3GXbTfl8a3SGNHm-vzYjZznVjzuZHAL0j7spYcvTrCO2Vg/s500/Roti%20Daiki%20Kotak%20(500%20x%20500%20px)%20(3).png" 
                     alt="Logo Roti Daiki" 
                     class="w-20 h-20 rounded-full mr-4 object-cover border-2 border-orange-200"
                     onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
                <div class="w-20 h-20 bg-orange-500 rounded-full flex items-center justify-center mr-4" style="display: none;">
                    <span class="text-white text-2xl font-bold">RD</span>
                </div>
                <div>
                    <h1 class="text-3xl font-bold text-orange-600">ROTI DAIKI</h1>
                    <p class="text-gray-600">Sistem Invoice & Kwitansi</p>
                </div>
            </div>
        </div>

        <!-- Form Input -->
        <div class="bg-white rounded-2xl shadow-xl p-8">
            <h2 class="text-2xl font-semibold text-gray-800 mb-6">Data Transaksi</h2>
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Tanggal Transaksi</label>
                    <input type="date" id="tanggal" class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-orange-500 focus:border-transparent">
                </div>
                
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Nomor Invoice</label>
                    <input type="text" id="noInvoice" readonly class="w-full px-4 py-3 bg-gray-100 border border-gray-300 rounded-lg text-gray-600">
                </div>
                
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Nama Pelanggan</label>
                    <input type="text" id="namaPelanggan" class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-orange-500 focus:border-transparent" placeholder="Masukkan nama pelanggan">
                </div>
                
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Nomor HP Pelanggan</label>
                    <input type="tel" id="nomorHP" class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-orange-500 focus:border-transparent" placeholder="08xxxxxxxxxx">
                </div>
                
                <div class="md:col-span-2">
                    <label class="block text-sm font-medium text-gray-700 mb-2">Pembuat Invoice</label>
                    <input type="text" id="pembuatInvoice" class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-orange-500 focus:border-transparent" placeholder="Nama pembuat invoice">
                </div>
            </div>

            <!-- Produk Section -->
            <div class="mb-6">
                <h3 class="text-xl font-semibold text-gray-800 mb-4">Produk</h3>
                
                <div class="flex flex-wrap gap-4 mb-4">
                    <select id="produkSelect" class="flex-1 min-w-64 px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-orange-500 focus:border-transparent">
                        <option value="">Pilih Produk</option>
                        <option value="Cranberry Cheese (Big)|18000">Cranberry Cheese (Big) - Rp 18.000</option>
                        <option value="Cranberry Cheese (Medium)|10000">Cranberry Cheese (Medium) - Rp 10.000</option>
                        <option value="Cranberry Cheese (Small)|5500">Cranberry Cheese (Small) - Rp 5.500</option>
                        <option value="Double Choco (Big)|20000">Double Choco (Big) - Rp 20.000</option>
                        <option value="Double Choco (Medium)|12000">Double Choco (Medium) - Rp 12.000</option>
                        <option value="Double Choco (Small)|6000">Double Choco (Small) - Rp 6.000</option>
                        <option value="Banana Cream Cheese (Big)|20000">Banana Cream Cheese (Big) - Rp 20.000</option>
                        <option value="Banana Cream Cheese (Reguler)|8000">Banana Cream Cheese (Reguler) - Rp 8.000</option>
                        <option value="Sausage Cheese (Big)|22000">Sausage Cheese (Big) - Rp 22.000</option>
                        <option value="Sausage Cheese (Reguler)|10000">Sausage Cheese (Reguler) - Rp 10.000</option>
                        <option value="Roti Tawar Gandum|50000">Roti Tawar Gandum - Rp 50.000</option>
                        <option value="Paket Happiness|28000">Paket Happiness - Rp 28.000</option>
                    </select>
                    <button onclick="tambahProduk()" class="px-6 py-3 bg-orange-500 text-white rounded-lg hover:bg-orange-600 transition-colors font-medium">Tambah</button>
                </div>

                <!-- Daftar Produk -->
                <div id="daftarProduk" class="space-y-3">
                    <!-- Produk akan ditambahkan di sini -->
                </div>
            </div>

            <!-- Biaya Tambahan -->
            <div class="bg-gray-50 rounded-lg p-6 mb-6">
                <h3 class="text-lg font-semibold text-gray-800 mb-4">Biaya Tambahan & Diskon</h3>
                
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Ongkos Kirim</label>
                        <input type="number" id="ongkosKirim" value="0" min="0" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-orange-500 focus:border-transparent" placeholder="0">
                    </div>
                    
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Pajak (%)</label>
                        <input type="number" id="pajak" value="0" min="0" max="100" step="0.1" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-orange-500 focus:border-transparent" placeholder="0">
                    </div>
                </div>
                
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Tipe Diskon</label>
                        <select id="tipeDiskon" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-orange-500 focus:border-transparent">
                            <option value="persen">Persen (%)</option>
                            <option value="rupiah">Rupiah (Rp)</option>
                        </select>
                    </div>
                    
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Nilai Diskon</label>
                        <input type="number" id="nilaiDiskon" value="0" min="0" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-orange-500 focus:border-transparent" placeholder="0">
                    </div>
                    
                    <div class="flex items-end">
                        <button onclick="hitungTotal()" class="w-full px-4 py-2 bg-orange-500 text-white rounded-lg hover:bg-orange-600 transition-colors font-medium">Hitung Ulang</button>
                    </div>
                </div>
            </div>

            <!-- Total -->
            <div class="bg-orange-50 rounded-lg p-6 mb-6">
                <div class="space-y-2">
                    <div class="flex justify-between">
                        <span class="text-gray-700">Subtotal Produk:</span>
                        <span id="subtotalProduk" class="font-medium">Rp 0</span>
                    </div>
                    <div class="flex justify-between">
                        <span class="text-gray-700">Ongkos Kirim:</span>
                        <span id="displayOngkir" class="font-medium">Rp 0</span>
                    </div>
                    <div class="flex justify-between">
                        <span class="text-gray-700">Pajak:</span>
                        <span id="displayPajak" class="font-medium">Rp 0</span>
                    </div>
                    <div class="flex justify-between text-red-600">
                        <span>Diskon:</span>
                        <span id="displayDiskon" class="font-medium">- Rp 0</span>
                    </div>
                    <hr class="border-gray-300">
                    <div class="flex justify-between items-center">
                        <span class="text-lg font-semibold text-gray-800">Total Pembayaran:</span>
                        <span id="totalHarga" class="text-2xl font-bold text-orange-600">Rp 0</span>
                    </div>
                </div>
            </div>

            <!-- Tombol Aksi -->
            <div class="flex flex-wrap gap-4">
                <button onclick="cetakInvoice()" class="flex-1 min-w-48 px-6 py-3 bg-blue-500 text-white rounded-lg hover:bg-blue-600 transition-colors font-medium">
                    📄 Cetak Invoice
                </button>
                <button onclick="cetakKwitansi()" class="flex-1 min-w-48 px-6 py-3 bg-green-500 text-white rounded-lg hover:bg-green-600 transition-colors font-medium">
                    🧾 Cetak Kwitansi
                </button>
                <button onclick="resetForm()" class="flex-1 min-w-48 px-6 py-3 bg-gray-500 text-white rounded-lg hover:bg-gray-600 transition-colors font-medium">
                    🔄 Reset
                </button>
            </div>
        </div>
    </div>

    <script>
        let produkList = [];
        
        document.addEventListener('DOMContentLoaded', function() {
            const today = new Date().toISOString().split('T')[0];
            document.getElementById('tanggal').value = today;
            generateNoInvoice();
        });

        function generateNoInvoice() {
            const tanggal = document.getElementById('tanggal').value;
            if (tanggal) {
                const date = new Date(tanggal);
                const bulan = String(date.getMonth() + 1).padStart(2, '0');
                const tahun = date.getFullYear();
                const randomNum = Math.floor(Math.random() * 90000) + 10000;
                document.getElementById('noInvoice').value = 'INV' + bulan + tahun + randomNum;
            }
        }

        document.getElementById('tanggal').addEventListener('change', generateNoInvoice);

        function tambahProduk() {
            const select = document.getElementById('produkSelect');
            const selectedValue = select.value;
            
            if (!selectedValue) {
                alert('Silakan pilih produk terlebih dahulu!');
                return;
            }

            const parts = selectedValue.split('|');
            const nama = parts[0];
            const harga = parseInt(parts[1]);

            const existingIndex = produkList.findIndex(item => item.nama === nama);
            
            if (existingIndex !== -1) {
                produkList[existingIndex].qty += 1;
            } else {
                produkList.push({
                    nama: nama,
                    harga: harga,
                    qty: 1
                });
            }

            updateDaftarProduk();
            select.value = '';
        }

        function updateDaftarProduk() {
            const container = document.getElementById('daftarProduk');
            container.innerHTML = '';

            for (let i = 0; i < produkList.length; i++) {
                const item = produkList[i];
                const div = document.createElement('div');
                div.className = 'flex items-center justify-between bg-gray-50 p-4 rounded-lg';
                
                const produkInfo = document.createElement('div');
                produkInfo.className = 'flex-1';
                produkInfo.innerHTML = '<span class="font-medium">' + item.nama + '</span><span class="text-gray-600 ml-2">@ Rp ' + item.harga.toLocaleString('id-ID') + '</span>';
                
                const controls = document.createElement('div');
                controls.className = 'flex items-center gap-3';
                
                const minusBtn = document.createElement('button');
                minusBtn.className = 'w-8 h-8 bg-red-500 text-white rounded-full hover:bg-red-600 flex items-center justify-center';
                minusBtn.textContent = '-';
                minusBtn.onclick = function() { ubahQty(i, -1); };
                
                const qtySpan = document.createElement('span');
                qtySpan.className = 'w-12 text-center font-medium';
                qtySpan.textContent = item.qty;
                
                const plusBtn = document.createElement('button');
                plusBtn.className = 'w-8 h-8 bg-green-500 text-white rounded-full hover:bg-green-600 flex items-center justify-center';
                plusBtn.textContent = '+';
                plusBtn.onclick = function() { ubahQty(i, 1); };
                
                const totalSpan = document.createElement('span');
                totalSpan.className = 'w-24 text-right font-semibold';
                totalSpan.textContent = 'Rp ' + (item.harga * item.qty).toLocaleString('id-ID');
                
                const deleteBtn = document.createElement('button');
                deleteBtn.className = 'w-8 h-8 bg-gray-500 text-white rounded-full hover:bg-gray-600 flex items-center justify-center';
                deleteBtn.textContent = '×';
                deleteBtn.onclick = function() { hapusProduk(i); };
                
                controls.appendChild(minusBtn);
                controls.appendChild(qtySpan);
                controls.appendChild(plusBtn);
                controls.appendChild(totalSpan);
                controls.appendChild(deleteBtn);
                
                div.appendChild(produkInfo);
                div.appendChild(controls);
                container.appendChild(div);
            }

            updateTotal();
        }

        function ubahQty(index, change) {
            produkList[index].qty += change;
            if (produkList[index].qty <= 0) {
                produkList.splice(index, 1);
            }
            updateDaftarProduk();
        }

        function hapusProduk(index) {
            produkList.splice(index, 1);
            updateDaftarProduk();
        }

        function updateTotal() {
            hitungTotal();
        }

        function hitungTotal() {
            let subtotal = 0;
            for (let i = 0; i < produkList.length; i++) {
                subtotal += produkList[i].harga * produkList[i].qty;
            }
            
            const ongkir = parseFloat(document.getElementById('ongkosKirim').value) || 0;
            const pajakPersen = parseFloat(document.getElementById('pajak').value) || 0;
            const tipeDiskon = document.getElementById('tipeDiskon').value;
            const nilaiDiskon = parseFloat(document.getElementById('nilaiDiskon').value) || 0;

            const pajak = (subtotal * pajakPersen) / 100;

            let diskon = 0;
            if (tipeDiskon === 'persen') {
                diskon = ((subtotal + ongkir + pajak) * nilaiDiskon) / 100;
            } else {
                diskon = nilaiDiskon;
            }

            const total = Math.max(0, subtotal + ongkir + pajak - diskon);

            document.getElementById('subtotalProduk').textContent = 'Rp ' + subtotal.toLocaleString('id-ID');
            document.getElementById('displayOngkir').textContent = 'Rp ' + ongkir.toLocaleString('id-ID');
            document.getElementById('displayPajak').textContent = 'Rp ' + pajak.toLocaleString('id-ID');
            document.getElementById('displayDiskon').textContent = '- Rp ' + diskon.toLocaleString('id-ID');
            document.getElementById('totalHarga').textContent = 'Rp ' + total.toLocaleString('id-ID');
        }

        document.getElementById('ongkosKirim').addEventListener('input', hitungTotal);
        document.getElementById('pajak').addEventListener('input', hitungTotal);
        document.getElementById('tipeDiskon').addEventListener('change', hitungTotal);
        document.getElementById('nilaiDiskon').addEventListener('input', hitungTotal);

        function cetakInvoice() {
            if (!validasiForm()) {
                return;
            }

            const data = getFormData();
            const newWindow = window.open('', '_blank');
            
            let produkRows = '';
            for (let i = 0; i < produkList.length; i++) {
                const item = produkList[i];
                produkRows += '<tr><td style="border: 1px solid #ccc; padding: 12px;">' + item.nama + '</td><td style="border: 1px solid #ccc; padding: 12px; text-align: center;">' + item.qty + '</td><td style="border: 1px solid #ccc; padding: 12px; text-align: right;">Rp ' + item.harga.toLocaleString('id-ID') + '</td><td style="border: 1px solid #ccc; padding: 12px; text-align: right;">Rp ' + (item.harga * item.qty).toLocaleString('id-ID') + '</td></tr>';
