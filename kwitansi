        function validasiForm() {
            const namaPelanggan = document.getElementById('namaPelanggan').value;
            const nomorHP = document.getElementById('nomorHP').value;
            const pembuatInvoice = document.getElementById('pembuatInvoice').value;

            if (!namaPelanggan || namaPelanggan.trim() === '') {
                alert('Mohon masukkan nama pelanggan!');
                return false;
            }

            if (!nomorHP || nomorHP.trim() === '') {
                alert('Mohon masukkan nomor HP pelanggan!');
                return false;
            }

            if (!pembuatInvoice || pembuatInvoice.trim() === '') {
                alert('Mohon masukkan nama pembuat invoice!');
                return false;
            }

            if (produkList.length === 0) {
                alert('Mohon tambahkan minimal satu produk!');
                return false;
            }

            return true;
        }

        function getFormData() {
            let subtotal = 0;
            for (let i = 0; i < produkList.length; i++) {
                subtotal += produkList[i].harga * produkList[i].qty;
            }
            
            const ongkir = parseFloat(document.getElementById('ongkosKirim').value) || 0;
            const pajakPersen = parseFloat(document.getElementById('pajak').value) || 0;
            const tipeDiskon = document.getElementById('tipeDiskon').value;
            const nilaiDiskon = parseFloat(document.getElementById('nilaiDiskon').value) || 0;

            const pajak = (subtotal * pajakPersen) / 100;

            let diskon = 0;
            if (tipeDiskon === 'persen') {
                diskon = ((subtotal + ongkir + pajak) * nilaiDiskon) / 100;
            } else {
                diskon = nilaiDiskon;
            }

            const total = Math.max(0, subtotal + ongkir + pajak - diskon);
            
            return {
                tanggal: document.getElementById('tanggal').value,
                noInvoice: document.getElementById('noInvoice').value,
                namaPelanggan: document.getElementById('namaPelanggan').value,
                nomorHP: document.getElementById('nomorHP').value,
                pembuatInvoice: document.getElementById('pembuatInvoice').value,
                subtotal: subtotal,
                ongkir: ongkir,
                pajakPersen: pajakPersen,
                pajak: pajak,
                tipeDiskon: tipeDiskon,
                nilaiDiskon: nilaiDiskon,
                diskon: diskon,
                total: total
            };
        }

        function formatTanggal(dateString) {
            const date = new Date(dateString);
            const bulan = [
                'Januari', 'Februari', 'Maret', 'April', 'Mei', 'Juni',
                'Juli', 'Agustus', 'September', 'Oktober', 'November', 'Desember'
            ];
            return date.getDate() + ' ' + bulan[date.getMonth()] + ' ' + date.getFullYear();
        }

        function resetForm() {
            document.getElementById('namaPelanggan').value = '';
            document.getElementById('nomorHP').value = '';
            document.getElementById('pembuatInvoice').value = '';
            
            document.getElementById('ongkosKirim').value = 0;
            document.getElementById('pajak').value = 0;
            document.getElementById('tipeDiskon').value = 'persen';
            document.getElementById('nilaiDiskon').value = 0;
            
            produkList = [];
            
            document.getElementById('daftarProduk').innerHTML = '';
            
            const today = new Date().toISOString().split('T')[0];
            document.getElementById('tanggal').value = today;
            generateNoInvoice();
            
            hitungTotal();
            
            alert('Form berhasil direset!');
        }
    </script>
