 class="header"><img src="https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEiPWTOigXHC4s2Jq1aJTWEPS-nTLyKot0alhBN4VtQCl-tmV7F29iXZuDoPXxX-mxVXBrzTa36G5xXzg4ZarWWegUAuN7QkfEBnEeJjl-IrE93CPvs5dAljCocRHbYhBZP4lcHSzyPEdRM6J3GXbTfl8a3SGNHm-vzYjZznVjzuZHAL0j7spYcvTrCO2Vg/s500/Roti%20Daiki%20Kotak%20(500%20x%20500%20px)%20(3).png" alt="Logo Roti Daiki" class="logo"><div class="company-name">ROTI DAIKI</div><div class="invoice-title">INVOICE</div></div><div class="info-grid"><div class="info-box"><div class="info-title">Informasi Invoice:</div><div class="info-item"><strong>No. Invoice:</strong> ' + data.noInvoice + '</div><div class="info-item"><strong>Tanggal:</strong> ' + formatTanggal(data.tanggal) + '</div><div class="info-item"><strong>Pembuat:</strong> ' + data.pembuatInvoice + '</div></div><div class="info-box"><div class="info-title">Informasi Pelanggan:</div><div class="info-item"><strong>Nama:</strong> ' + data.namaPelanggan + '</div><div class="info-item"><strong>No. HP:</strong> ' + data.nomorHP + '</div></div></div><table class="table"><thead><tr><th>Produk</th><th>Qty</th><th>Harga</th><th>Subtotal</th></tr></thead><tbody>' + produkRows + '<tr style="background: #f8f9fa;"><td colspan="3" style="text-align: right; font-weight: bold;">Subtotal Produk:</td><td style="text-align: right; font-weight: bold;">Rp ' + data.subtotal.toLocaleString('id-ID') + '</td></tr><tr><td colspan="3" style="text-align: right;">Ongkos Kirim:</td><td style="text-align: right;">Rp ' + data.ongkir.toLocaleString('id-ID') + '</td></tr><tr><td colspan="3" style="text-align: right;">Pajak (' + data.pajakPersen + '%):</td><td style="text-align: right;">Rp ' + data.pajak.toLocaleString('id-ID') + '</td></tr><tr><td colspan="3" style="text-align: right; color: #dc2626;">Diskon:</td><td style="text-align: right; color: #dc2626;">- Rp ' + data.diskon.toLocaleString('id-ID') + '</td></tr><tr class="total-row"><td colspan="3" style="text-align: right;">TOTAL PEMBAYARAN:</td><td style="text-align: right;" class="total-amount">Rp ' + data.total.toLocaleString('id-ID') + '</td></tr></tbody></table><div class="footer-section"><div class="footer-text"><p style="font-size: 18px; margin-bottom: 10px;">Terima kasih atas kepercayaan Anda!</p><p style="font-weight: bold;">Roti Daiki - Roti Segar Setiap Hari</p></div><div class="transfer-info"><div class="transfer-title">💳 INFORMASI TRANSFER</div><div class="transfer-details"><strong>Bank Permata Syariah</strong><br>No. Rek: <strong>9925684055</strong><br>a.n <strong>Achmad Ghozali</strong></div></div></div><div class="no-print"><button onclick="window.print()" class="btn btn-primary">Print Invoice</button><button onclick="window.close()" class="btn btn-secondary">Tutup</button></div></div></body></html>';
            
            newWindow.document.write(invoiceHTML);
            newWindow.document.close();
            newWindow.focus();
        }

        function cetakKwitansi() {
            if (!validasiForm()) {
                return;
            }

            const data = getFormData();
            const newWindow = window.open('', '_blank');
            
            let produkList2 = '';
            for (let i = 0; i < produkList.length; i++) {
                const item = produkList[i];
                produkList2 += '<li style="margin-bottom: 5px; color: #555;">' + item.nama + ' (' + item.qty + 'x) - Rp ' + (item.harga * item.qty).toLocaleString('id-ID') + '</li>';
            }
            
